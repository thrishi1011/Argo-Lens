{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      "@/ui-ux/*": [
        "./UI, UX design/*"
      ],
      "@/components/*": [
        "./UI, UX design/components/*"
      ],
      "@/integrations/*": [
        "./back-end/integrations/*"
      ]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}