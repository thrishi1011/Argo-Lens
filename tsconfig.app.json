{
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ],
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      "@/ui-ux/*": [
        "./UI, UX design/*"
      ],
      "@/components/*": [
        "./UI, UX design/components/*"
      ],
      "@/integrations/*": [
        "./back-end/integrations/*"
      ]
    }
  },
  "include": [
    "frontend",
    "UI, UX design",
    "back-end"
  ]
}